     local open_filename = properties["stream-open-filename"]
     local ytdl = open_filename and properties["demuxer-via-network"] and path ~= open_filename
+    local preview = false
     if ytdl then
         path = open_filename
+        -- Reuse extraction data instead of seeking the full 4K stream for previews.
+        local result = mp.get_property_native("user-data/mpv/ytdl/json-subprocess-result")
+        local data = result and mp.utils.parse_json(result.stdout or "")
+        if data and data.extractor_key == "Youtube" and not data.is_live
+            and #mp.get_property_native("vf", {}) == 0
+            and mp.get_property("video-crop", "") == "" then
+            local height = 0
+            local protocol = ((data.requested_formats or {})[1] or data).protocol
+            for _, format in ipairs(data.formats or {}) do
+                if format.protocol == protocol and format.url
+                    and (format.available_at or 0) <= os.time()
+                    and format.dynamic_range == data.dynamic_range
+                    and (format.height or 0) > height and format.height <= 360 then
+                    path, height, preview = format.url, format.height, true
+                end
+            end
+        end
     end
 
