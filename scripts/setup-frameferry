#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Install or remove Frame Ferry's isolated user files without touching normal mpv settings."""

import argparse
import hashlib
import json
import os
import shutil
import stat
import sys
import tempfile
import time
from pathlib import Path

from frameferry_config import DEFAULTS, config_path, load_config, supported_executable
from frameferry_install import BROWSERS, atomic_write, digest, extension_id

ROOT = Path(__file__).resolve().parents[1]


def original_is_in_place(path, current, checksum, backup):
    try:
        saved = backup.lstat()
        if stat.S_ISLNK(current.st_mode) and stat.S_ISLNK(saved.st_mode):
            return path.readlink() == backup.readlink()
        return (
            checksum is not None
            and current.st_mode == saved.st_mode
            and current.st_mtime_ns == saved.st_mtime_ns
            and checksum == digest(backup)
        )
    except OSError:
        return False


def uninstall(ledger, records):
    kept = {}
    failed = False
    for name, record in records.items():
        path = Path(name)
        backup = Path(record['backup']) if record['backup'] else None
        try:
            try:
                current = path.lstat()
            except FileNotFoundError:
                current = None
            checksum = digest(path) if current and stat.S_ISREG(current.st_mode) else None
            # The original can already be in place if uninstall stopped before it updated the ledger.
            if backup and current and original_is_in_place(path, current, checksum, backup):
                continue
            if current and checksum != record['hash']:
                kept[name] = record
                print(f'Kept changed file: {path}')
                continue
            if backup:
                path.parent.mkdir(parents=True, exist_ok=True)
                with tempfile.TemporaryDirectory(dir=path.parent) as directory:
                    staged = Path(directory) / 'original'
                    shutil.copy2(backup, staged, follow_symlinks=False)
                    staged.replace(path)
            elif current:
                path.unlink(missing_ok=True)
            else:
                continue
            print(f'Removed managed version: {path}')
        except OSError as error:
            kept[name] = record
            failed = True
            action = f'restore {path} from {backup}' if backup else f'remove {path}'
            print(
                f'Could not {action}: {error}. Check that the paths are accessible, '
                'then run ./scripts/install.sh --uninstall again.',
                file=sys.stderr,
            )
    try:
        atomic_write(ledger, (json.dumps(kept, indent=2) + '\n').encode(), 0o600)
    except OSError as error:
        print(
            f'Could not update {ledger}: {error}. Check access, then run ./scripts/install.sh --uninstall again.',
            file=sys.stderr,
        )
        return 1
    if failed:
        return 1
    print(
        'Remove Frame Ferry from the browser Extensions page. Component downloads and private logs remain; see README.'
    )
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--browser', choices=BROWSERS, default='helium')
    parser.add_argument(
        '--browser-data-dir', type=Path, help='Custom Chromium user-data root, not a profile subdirectory'
    )
    parser.add_argument('--uninstall', action='store_true', help='Remove unchanged managed files and restore originals')
    args = parser.parse_args()
    home = Path.home()
    config = Path(os.environ.get('XDG_CONFIG_HOME', home / '.config'))
    data = Path(os.environ.get('XDG_DATA_HOME', home / '.local/share')) / 'frameferry'
    state = Path(os.environ.get('XDG_STATE_HOME', home / '.local/state')) / 'frameferry'
    if not all(path.is_absolute() for path in (config, data, state)):
        parser.error('XDG config, data, and state directories must be absolute paths.')
    if args.browser_data_dir:
        args.browser_data_dir = args.browser_data_dir.expanduser().resolve()
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    ledger = state / 'installation.json'
    records = json.loads(ledger.read_text()) if ledger.exists() else {}
    if args.uninstall:
        return uninstall(ledger, records)
    if sys.version_info < (3, 10) or sys.platform != 'linux':
        parser.error('Native Linux with Python 3.10+ is required.')
    try:
        settings = load_config()
        for tool in ('mpv', 'yt_dlp', 'deno'):
            supported_executable(settings, tool)
    except (OSError, ValueError) as error:
        parser.error(str(error))

    def install_bytes(content, target, mode=0o644):
        name = str(target)
        previous = records.get(name)
        desired = hashlib.sha256(content).hexdigest()
        if target.exists() and previous:
            current = digest(target)
            if current != previous['hash']:
                print(f'Kept user changes: {target}')
                return
            if current == desired and target.stat().st_mode & 0o777 == mode:
                return
        backup = previous['backup'] if previous else None
        if (target.exists() or target.is_symlink()) and not previous:
            backup_dir = state / 'backups'
            backup_dir.mkdir(exist_ok=True)
            backup = str(backup_dir / (str(time.time_ns()) + '-' + target.name))
            shutil.copy2(target, backup, follow_symlinks=False)
        atomic_write(target, content, mode)
        records[name] = {'hash': desired, 'backup': backup}
        atomic_write(ledger, (json.dumps(records, indent=2) + '\n').encode(), 0o600)

    if not config_path().exists():
        install_bytes((json.dumps(DEFAULTS, indent=2) + '\n').encode(), config_path(), 0o600)
    install_bytes((ROOT / 'scripts/frameferry_config.py').read_bytes(), data / 'bin/frameferry_config.py')
    player = config / 'frameferry/mpv'
    (player / 'screenshots').mkdir(parents=True, exist_ok=True)
    for source in (ROOT / 'config/mpv').rglob('*'):
        if source.is_file():
            install_bytes(source.read_bytes(), player / source.relative_to(ROOT / 'config/mpv'))
    install_bytes(('ytdl_path=' + str(data / 'bin/yt-dlp-mpv') + '\n').encode(), player / 'script-opts/ytdl_hook.conf')
    for name in ('frameferry-native', 'yt-dlp-mpv', 'yt-dlp-update-background'):
        install_bytes((ROOT / 'scripts' / name).read_bytes(), data / 'bin' / name, 0o755)
    for source in (ROOT / 'extension').rglob('*'):
        if source.is_file():
            install_bytes(source.read_bytes(), data / 'extension' / source.relative_to(ROOT / 'extension'))
    for name in ('LICENSE', 'THIRD_PARTY.md', 'LICENSES/MPL-2.0.txt'):
        install_bytes((ROOT / name).read_bytes(), data / name)
    browser = args.browser_data_dir or config / BROWSERS[args.browser]
    manifest = {
        'name': 'frameferry',
        'description': 'Frame Ferry playback handoff',
        'type': 'stdio',
        'path': str(data / 'bin/frameferry-native'),
        'allowed_origins': ['chrome-extension://' + extension_id(ROOT / 'extension/manifest.json') + '/'],
    }
    install_bytes((json.dumps(manifest, indent=2) + '\n').encode(), browser / 'NativeMessagingHosts/frameferry.json')
    print(f'Player configuration: {player}')
    print(f'Load unpacked in your browser: {data / "extension"}')
    print('Reload the extension after updates. Your normal mpv configuration was not changed.')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
