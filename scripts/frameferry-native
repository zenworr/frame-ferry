#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Frame Ferry protocol v1: a bounded request and a playback-ready response."""

import json
import math
import os
from pathlib import Path
import socket
import struct
import subprocess
import sys
import tempfile
import time
from urllib.parse import parse_qsl, urlencode, urlsplit, urlunsplit

from frameferry_config import executable, load_config, proxy_environment


CONFIG = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config'))) / 'frameferry/mpv'
STATE = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'frameferry'
HEIGHTS = {0, 480, 720, 1080, 1440, 2160}


def validate(message):
    if not isinstance(message, dict) or type(message.get('version')) is not int or message['version'] != 1:
        raise ValueError('Unsupported request. Update the extension and native host together.')
    allowed = {'version', 'action'}
    if message.get('action') != 'check':
        allowed |= {'url', 'position', 'quality', 'fullscreen'}
    if message.keys() - allowed:
        raise ValueError('Unknown request fields.')
    if message.get('action') == 'check':
        return message
    if message.get('action') != 'play':
        raise ValueError('Unknown action.')
    url = message.get('url')
    if not isinstance(url, str) or len(url) > 8192 or any(ord(c) < 32 for c in url):
        raise ValueError('The page URL is not valid.')
    parsed = urlsplit(url)
    if parsed.scheme not in ('http', 'https') or not parsed.hostname or parsed.username or parsed.password:
        raise ValueError('Only HTTP and HTTPS links without embedded credentials are supported.')
    _ = parsed.port
    position = message.get('position')
    if position is not None and (type(position) not in (int, float) or not math.isfinite(position)
                                 or position < 0 or position > 31536000):
        raise ValueError('Playback position must be a finite, non-negative number of seconds.')
    if type(message.get('quality')) is not int or message['quality'] not in HEIGHTS:
        raise ValueError('Unsupported maximum resolution.')
    if type(message.get('fullscreen')) is not bool:
        raise ValueError('Fullscreen must be on or off.')
    return message


def command_for(message, ipc, config=None):
    config = load_config() if config is None else config
    command = [executable(config, 'mpv'), f'--config-dir={CONFIG}', f'--input-ipc-server={ipc}',
               '--idle=no', '--terminal=yes', '--input-terminal=no', '--term-osd=no',
               '--term-status-msg=', '--msg-color=no', '--msg-level=all=info',
               '--fullscreen=' + ('yes' if message['fullscreen'] else 'no'),
               f'--script-opts-append=youtube-recovery_timeout={config["recovery_timeout"]}']
    height = message['quality']
    if height:
        command.append(f'--ytdl-format=bestvideo[height<=?{height}]+bestaudio/best[height<=?{height}]')
    url, position = message['url'], message.get('position')
    if position is not None:
        parts = urlsplit(url)
        host = parts.hostname.lower().rstrip('.')
        if host in ('youtu.be', 'youtube.com', 'youtube-nocookie.com') or host.endswith(('.youtube.com', '.youtube-nocookie.com')):
            query = [(k, v) for k, v in parse_qsl(parts.query, keep_blank_values=True)
                     if k not in ('t', 'start', 'time_continue')]
            query.append(('t', str(int(position))))
            url = urlunsplit((parts.scheme, parts.netloc, parts.path, urlencode(query), ''))
        # Entry-local options must not affect a later video opened in this player.
        command += ['--{', f'--start={position}', url, '--}']
    else:
        command += ['--', url]
    return command


def wait_for_playback(process, path, deadline):
    with socket.socket(socket.AF_UNIX) as ipc:
        ipc.settimeout(1)
        while True:
            if process.poll() is not None:
                raise RuntimeError('mpv exited before playback started. Check the player log.')
            if time.monotonic() >= deadline:
                raise TimeoutError('mpv did not become ready in time.')
            try:
                ipc.connect(str(path))
                break
            except (FileNotFoundError, ConnectionRefusedError):
                time.sleep(.05)
        with ipc.makefile('rb') as reader:
            serial = 0
            def property_value(name):
                nonlocal serial
                serial += 1
                ipc.settimeout(max(.1, deadline - time.monotonic()))
                ipc.sendall((json.dumps({'command': ['get_property', name], 'request_id': serial}) + '\n').encode())
                while True:
                    if time.monotonic() >= deadline:
                        raise TimeoutError('mpv did not become ready in time.')
                    line = reader.readline()
                    if not line:
                        raise RuntimeError('mpv closed the connection before playback started.')
                    event = json.loads(line)
                    if event.get('request_id') == serial:
                        return event.get('data')
            while time.monotonic() < deadline:
                if property_value('user-data/youtube-quality/slate'):
                    raise RuntimeError('No playable stream was found. Try another quality or continue in the browser.')
                position = property_value('time-pos')
                if position is not None and not property_value('user-data/youtube-quality/loading') and not property_value('seeking'):
                    return
                time.sleep(.1)
    raise TimeoutError('mpv did not become ready in time.')


def handle(message):
    message = validate(message)
    config = load_config()
    if not (CONFIG / 'mpv.conf').is_file():
        raise FileNotFoundError('Frame Ferry is not set up. Run scripts/setup-frameferry.')
    if message['action'] == 'check':
        for tool in ('mpv', 'yt_dlp', 'deno'):
            executable(config, tool)
        return {'ok': True, 'message': 'Native host and player configuration found. Playback has not been tested.'}
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    STATE.chmod(0o700)
    for old in sorted(STATE.glob('player-*.log'), key=lambda p: p.stat().st_mtime, reverse=True)[19:]:
        old.unlink(missing_ok=True)
    with tempfile.TemporaryDirectory(prefix='frameferry-', dir='/tmp') as temp:
        ipc = Path(temp) / 'ipc'
        command = command_for(message, ipc, config)
        with tempfile.NamedTemporaryFile(prefix='player-', suffix='.log', dir=STATE, delete=False) as output:
            process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=output,
                                       stderr=subprocess.STDOUT, start_new_session=True,
                                       env=proxy_environment(config))
        try:
            wait_for_playback(process, ipc, time.monotonic() + config['startup_timeout'])
        except Exception:
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()
            raise
    return {'ok': True, 'message': 'mpv is playing.', 'pid': process.pid}


def serve(incoming, outgoing):
    def read_exact(size):
        result = bytearray()
        while len(result) < size:
            part = incoming.read(size - len(result))
            if not part:
                raise ValueError('Incomplete native message.')
            result.extend(part)
        return result
    try:
        size, = struct.unpack('=I', read_exact(4))
        if not 0 < size <= 65536:
            raise ValueError('Native message is too large or empty.')
        result = handle(json.loads(read_exact(size)))
    except (ValueError, OSError, RuntimeError) as error:
        result = {'ok': False, 'message': str(error)}
    body = json.dumps(result, ensure_ascii=True).encode()
    outgoing.write(struct.pack('=I', len(body)) + body)
    outgoing.flush()


if __name__ == '__main__':
    try:
        serve(sys.stdin.buffer, sys.stdout.buffer)
    except BrokenPipeError:
        pass
